{
  "services": {
    "virtual-hawks-backend": {
      "root": ".",
      "framework": "nextjs"
    },
    "virtual-hawks-api": {
      "root": "api",
      "framework": "python"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "virtual-hawks-api",
        "path": "/api/$1"
      }
    }
  ]
}
